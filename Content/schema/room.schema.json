{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hearthdelve://room",
  "title": "Hearthdelve room chunk",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "biome", "width", "height", "tag", "tiles", "collision", "spawns"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "biome": { "type": "string", "minLength": 1 },
    "width": { "const": 16 },
    "height": { "const": 16 },
    "tag": { "enum": ["entry", "stairs", "arena", "side"] },
    "tiles": {
      "type": "array",
      "minItems": 256,
      "maxItems": 256,
      "items": { "type": "integer", "minimum": 0 }
    },
    "collision": {
      "type": "array",
      "minItems": 256,
      "maxItems": 256,
      "items": { "type": "integer", "minimum": 0, "maximum": 1 }
    },
    "spawns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y", "w", "h"],
        "properties": {
          "x": { "type": "integer", "minimum": 0 },
          "y": { "type": "integer", "minimum": 0 },
          "w": { "type": "integer", "minimum": 1 },
          "h": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
