[
  {
    "id": "m0_default",
    "name": "Cellar Basics",
    "rules": [
      {
        "if": {
          "kind": "selfHPBelow",
          "value": 0.35
        },
        "then": {
          "kind": "potion"
        }
      },
      {
        "if": {
          "kind": "eliteWithin",
          "tiles": 4
        },
        "then": {
          "kind": "relic",
          "relic": "lantern_ward"
        }
      },
      {
        "if": {
          "kind": "enemiesWithin",
          "count": 3,
          "tiles": 3
        },
        "then": {
          "kind": "relic",
          "relic": "ember_flask"
        }
      }
    ]
  },
